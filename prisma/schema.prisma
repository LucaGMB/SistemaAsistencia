generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos: el rol se valida a nivel de aplicacion
// (ver src/lib/roles.ts). Valores validos: "ALUMNO" | "PROFESOR" | "ADMIN".
model User {
  id                  String   @id @default(cuid())
  dni                 String   @unique
  nombre              String
  apellido            String
  passwordHash        String
  role                String   @default("ALUMNO")

  // Alumnos y profesores pueden cambiar su propia contraseña una unica vez.
  // El admin no tiene esta opcion (ni para si mismo ni para restablecer la
  // de un profesor: eso queda fuera del alcance de la aplicacion).
  selfPasswordChangeUsed Boolean @default(false)

  active              Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendances         Attendance[]
  logsAsActor         AuditLog[] @relation("ActorLogs")
  logsAsTarget        AuditLog[] @relation("TargetLogs")
  cancelledClasses    CancelledClass[]
  classCodes          ClassCode[]
}

// Código de 4 dígitos generado por el profesor para habilitar el presente en el aula
model ClassCode {
  id          String   @id @default(cuid())
  // Fecha de la clase en formato YYYY-MM-DD
  date        String   @unique
  code        String   // Código de 4 dígitos (ej. "4829")

  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Clases anuladas (feriados, paros, suspensiones). Las asistencias que caigan
// en una fecha anulada no acreditan horas, pero no se borran: si la clase se
// reactiva, vuelven a contar. Se pueden anular clases pasadas y futuras.
model CancelledClass {
  id            String   @id @default(cuid())
  // Fecha de la clase anulada en formato YYYY-MM-DD
  date          String   @unique
  dayOfWeek     String
  reason        String?

  cancelledBy   User?    @relation(fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledById String?

  createdAt     DateTime @default(now())

  @@index([date])
}

model Attendance {
  id         String   @id @default(cuid())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String

  // Fecha de la clase en formato YYYY-MM-DD (huso horario America/Argentina/Buenos_Aires)
  date       String
  // Nombre del dia de clase: "Martes" | "Jueves" | "Viernes"
  dayOfWeek  String
  // Horas acreditadas por esa asistencia (cantidad de modulos de 30min)
  hours      Int

  // Quien genero el registro originalmente
  source     String   // "ALUMNO" | "ADMIN"
  note       String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
  // Las consultas por fecha (anular clase, carga manual) filtran solo por
  // date, que el indice compuesto de arriba no cubre al no ser prefijo.
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  target     User?    @relation("TargetLogs", fields: [targetId], references: [id], onDelete: SetNull)
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}
